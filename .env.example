# Literal KEY=value, no quotes, shell expansion, inline comments, or spaces.
DOMAIN=xdadwal.in
# Replace with the server's reserved LAN IPv4 address before setup.
LAN_IP=192.168.1.111
TZ=Asia/Kolkata
DATA_ROOT=/ohara
# Dedicated share; do not point at your home directory or photo archive.
FILES_ROOT=/ohara/files
RUN_UID=1000
RUN_GID=1000
# Required only when obtaining certificates; replace before public activation.
ACME_EMAIL=admin@xdadwal.in
REQUESTS_HOST=watch.xdadwal.in
FILES_HOST=files.xdadwal.in
SPEED_HOST=speed.xdadwal.in

# Optional on existing installations; defaults derive from DATA_ROOT and DOMAIN.
MEDIA_ROOT=/ohara/media
JELLYFIN_HOST=jellyfin.xdadwal.in
