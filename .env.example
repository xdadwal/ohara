# Literal KEY=value; do not source this file or use Compose directly.
# Deployment settings below cannot contain whitespace. Credential values may.
DOMAIN=xdadwal.in
TZ=Asia/Kolkata
DATA_ROOT=/ohara
RUN_UID=1000
RUN_GID=1000
# Required only when obtaining certificates; replace before public activation.
ACME_EMAIL=admin@xdadwal.in
REQUESTS_HOST=seerr.xdadwal.in
SPEED_HOST=speed.xdadwal.in

# Optional on existing installations; defaults derive from DATA_ROOT and DOMAIN.
MEDIA_ROOT=/ohara/media
# Optional mergerfs guard: set both paths to the pool and install its systemd unit.
# See docs/storage-pool.md. Leave unset for ordinary storage.
# MEDIA_POOL_MOUNT=/ohara/mnt
JELLYFIN_HOST=tv.xdadwal.in

# Dashboard hostname; defaults to DOMAIN when omitted.
# Set ohara.xdadwal.in when a separate portfolio serves the apex.
HOMEPAGE_HOST=xdadwal.in
# Set 8010 alongside HOMEPAGE_HOST=ohara.xdadwal.in for a separate apex portfolio.
# 0 disables the optional route; run the portfolio process separately on loopback.
PORTFOLIO_PORT=0

# Music playback; defaults to music.DOMAIN when omitted.
NAVIDROME_HOST=music.xdadwal.in

# Uncomment and fill all required credentials privately. No defaults are supplied.
# Keep the resulting .env chmod 0600. See docs/credentials.md.
# HOMEPAGE_AUTH_ENABLED=true
# HOMEPAGE_AUTH_PASSWORD=
# HOMEPAGE_AUTH_SECRET=
# JELLYFIN_PASSWORD=
# QBITTORRENT_PASSWORD=
# RADARR_PASSWORD=
# RADARR_API_KEY=
# SONARR_PASSWORD=
# SONARR_API_KEY=
# PROWLARR_PASSWORD=
# PROWLARR_API_KEY=
# LIDARR_PASSWORD=
# LIDARR_API_KEY=
# BAZARR_PASSWORD=
# BAZARR_API_KEY=
# NAVIDROME_PASSWORD=
# Optional actual application-issued widget API keys, after account setup:
# HOMEPAGE_VAR_JELLYFIN_API_KEY=
# HOMEPAGE_VAR_SEERR_API_KEY=
# HOMEPAGE_VAR_IMMICH_API_KEY=
# Optional Bambuddy read-status-only application-issued key; never paste it in chat.
# HOMEPAGE_VAR_BAMBUDDY_API_KEY=
# Optional LAN DNS (scripts/adguard; separate Compose project).
# Use the real reserved LAN address and subnet; never forward router port 53.
# ADGUARD_BIND_IP=
# ADGUARD_NETWORK=
# ADGUARD_PASSWORD=

# Optional Immich (scripts/immich; separate project, machine learning disabled).
# Confirm paths and mounts before prepare/up. The current approved disk is /.
# IMMICH_LIBRARY_ROOT=/ohara/immich/library
# IMMICH_DATABASE_ROOT=/ohara/immich/postgres
# IMMICH_LIBRARY_MOUNT=/
# IMMICH_DATABASE_MOUNT=/
# Independent database password, at least 16 ASCII letters/digits. Fill privately.
# IMMICH_DB_PASSWORD=

# Optional invite-only Google OAuth for Immich (real client issued by Google).
# IMMICH_GOOGLE_CLIENT_ID=
# IMMICH_GOOGLE_CLIENT_SECRET=

# Legacy compatibility only: accepted but ignored; unnecessary on fresh installs.
# Existing .env files may retain these retired Copyparty/DNS settings.
# FILES_HOST=
# FILES_ROOT=
# LAN_IP=

# Optional Bambuddy (scripts/bambuddy; separate project, owner/printer setup in UI).
# Defaults to DATA_ROOT/bambuddy on the internal filesystem. Confirm before setup.
# BAMBUDDY_ROOT=/ohara/bambuddy
# BAMBUDDY_MOUNT=/
