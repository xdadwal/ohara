# Ohara configuration template. scripts/setup copies it to the private .env once.
#
# Format: literal KEY=value lines. Never source this file or hand it to Compose.
# Settings cannot contain whitespace; credential values may. Keep .env chmod 0600.
# Unknown keys are rejected. Each key is documented in the guide named beside it.

# ---------------------------------------------------------------------------
# Required deployment settings
# ---------------------------------------------------------------------------
DOMAIN=xdadwal.in
TZ=Asia/Kolkata
DATA_ROOT=/ohara
RUN_UID=1000
RUN_GID=1000
# Required only when obtaining certificates; replace before public activation.
ACME_EMAIL=admin@xdadwal.in
REQUESTS_HOST=seerr.xdadwal.in
SPEED_HOST=speed.xdadwal.in

# ---------------------------------------------------------------------------
# Optional main-stack settings (defaults derive from DATA_ROOT and DOMAIN)
# ---------------------------------------------------------------------------
MEDIA_ROOT=/ohara/media
# Optional mergerfs guard: set both paths to the pool and install its systemd unit.
# See docs/storage-pool.md. Leave unset for ordinary storage.
# MEDIA_POOL_MOUNT=/ohara/mnt
JELLYFIN_HOST=tv.xdadwal.in

# Dashboard hostname; defaults to DOMAIN when omitted.
# Set ohara.xdadwal.in when a separate portfolio serves the apex.
HOMEPAGE_HOST=xdadwal.in
# Set 8010 alongside HOMEPAGE_HOST=ohara.xdadwal.in for a separate apex portfolio.
# 0 disables the optional route; run the portfolio process separately on loopback.
PORTFOLIO_PORT=0

# Music playback; defaults to music.DOMAIN when omitted.
NAVIDROME_HOST=music.xdadwal.in

# Set only when the Seerr site is restricted to the LAN; labels its dashboard card.
# SEERR_LAN_ONLY=true

# ---------------------------------------------------------------------------
# Main-stack credentials (docs/credentials.md)
# ---------------------------------------------------------------------------
# Uncomment and fill all required credentials privately. No defaults are supplied.
# JELLYFIN_PASSWORD and the RADARR/SONARR/PROWLARR/LIDARR/BAZARR_PASSWORD entries are
# setup-only: needed (16+ characters) to create those logins, then they may be removed.
# HOMEPAGE_AUTH_ENABLED=true
# HOMEPAGE_AUTH_PASSWORD=
# HOMEPAGE_AUTH_SECRET=
# JELLYFIN_PASSWORD=
# QBITTORRENT_PASSWORD=
# RADARR_PASSWORD=
# RADARR_API_KEY=
# SONARR_PASSWORD=
# SONARR_API_KEY=
# PROWLARR_PASSWORD=
# PROWLARR_API_KEY=
# LIDARR_PASSWORD=
# LIDARR_API_KEY=
# BAZARR_PASSWORD=
# BAZARR_API_KEY=
# NAVIDROME_PASSWORD=

# Optional actual application-issued widget API keys, after account setup
# (docs/homepage-widgets.md):
# HOMEPAGE_VAR_JELLYFIN_API_KEY=
# HOMEPAGE_VAR_SEERR_API_KEY=
# HOMEPAGE_VAR_IMMICH_API_KEY=
# Optional Bambuddy read-status-only application-issued key; never paste it in chat.
# HOMEPAGE_VAR_BAMBUDDY_API_KEY=

# ---------------------------------------------------------------------------
# Optional LAN DNS: scripts/adguard, separate Compose project (docs/adguard.md)
# ---------------------------------------------------------------------------
# Use the real reserved LAN address and subnet; never forward router port 53.
# ADGUARD_BIND_IP=
# ADGUARD_NETWORK=
# ADGUARD_PASSWORD=
# Optional LAN IPv4 of an AdGuard the owner runs on another device. When set, the
# bundled project is not started and the status command, service rewrite steps,
# alert DNS probe, Homepage widget and LAN route use that device instead. Nothing
# on it is managed from here. See docs/network.md.
# DNS_IP=

# ---------------------------------------------------------------------------
# Optional Immich: scripts/immich, separate project, machine learning disabled
# (docs/immich.md)
# ---------------------------------------------------------------------------
# Confirm paths and mounts before prepare/up. The current approved disk is /.
# IMMICH_LIBRARY_ROOT=/ohara/immich/library
# IMMICH_DATABASE_ROOT=/ohara/immich/postgres
# IMMICH_LIBRARY_MOUNT=/
# IMMICH_DATABASE_MOUNT=/
# Independent database password, at least 16 ASCII letters/digits. Fill privately.
# IMMICH_DB_PASSWORD=

# Optional invite-only Google OAuth for Immich (real client issued by Google;
# docs/immich-google-oauth.md).
# IMMICH_GOOGLE_CLIENT_ID=
# IMMICH_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional Bambuddy: scripts/bambuddy, separate project, owner/printer setup in
# its UI (docs/bambuddy.md)
# ---------------------------------------------------------------------------
# Defaults to DATA_ROOT/bambuddy on the internal filesystem. Confirm before setup.
# BAMBUDDY_ROOT=/ohara/bambuddy
# BAMBUDDY_MOUNT=/

# Optional existing owner login for scripts/orcaslicer configure; never sent to
# containers (docs/orcaslicer.md).
# BAMBUDDY_USERNAME=
# BAMBUDDY_PASSWORD=

# ---------------------------------------------------------------------------
# Optional ntfy notifications: scripts/ntfy, separate project (docs/ntfy.md)
# ---------------------------------------------------------------------------
# Supply an independent password privately; never send it in chat.
# NTFY_PASSWORD=
# NTFY_HOST=ntfy.xdadwal.in
# NTFY_ROOT=/ohara/ntfy
# NTFY_MOUNT=/
# NTFY_IOS_RELAY=none
# With explicit owner approval for iPhone wake-up metadata: NTFY_IOS_RELAY=https://ntfy.sh

# Optional explicit owner exception for ntfy only; empty/over-72-byte passwords remain invalid.
# NTFY_ALLOW_SHORT_PASSWORD=false

# Optional Homepage ntfy reader: separate owner-supplied password (16 characters
# minimum, 72 UTF-8 bytes maximum). Never use NTFY_PASSWORD here.
# Run sudo scripts/ntfy widget; see docs/alerts.md.
# NTFY_HOMEPAGE_PASSWORD=

# ---------------------------------------------------------------------------
# Retired settings: accepted but ignored, unnecessary on fresh installs
# ---------------------------------------------------------------------------
# Existing .env files may retain these Copyparty/DNS settings.
# FILES_HOST=
# FILES_ROOT=
# LAN_IP=
# Kutt was retired on 2026-11-25. Leftover KUTT_* settings are ignored; remove them.
