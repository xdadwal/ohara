server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @NAVIDROME_HOST@;
    ssl_certificate /etc/letsencrypt/live/ohara/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ohara/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Subsonic clients can include credentials in URLs; do not log them.
    access_log off;
    # Upstream failures also include full URLs in Nginx error messages.
    error_log /dev/null;
    location / {
        proxy_pass http://127.0.0.1:4533;
        include /etc/nginx/ohara-proxy-headers.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ohara_connection_upgrade;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
    }
}
