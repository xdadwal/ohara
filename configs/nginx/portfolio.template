# Optional portfolio process is provisioned separately; backend stays on loopback.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @DOMAIN@;
    ssl_certificate /etc/letsencrypt/live/ohara/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ohara/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # nginx.conf compresses only text/html; cover the portfolio's other text types.
    gzip_types text/css application/javascript text/javascript application/json application/xml text/xml text/plain image/svg+xml;
    gzip_vary on;
    # Browser caching for static files. HTML gets no Cache-Control here: every visit
    # must fetch a fresh page, because the page points at the current CSS version.
    # No "always": 404s and errors must not be cached.
    # The portfolio links CSS and fonts with a content version (?v=), so they can be
    # cached for a year. This depends on the app always linking them that way.
    location ^~ /static/css/ {
        proxy_pass http://127.0.0.1:@PORTFOLIO_PORT@;
        include /etc/nginx/ohara-proxy-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ^~ /static/fonts/ {
        proxy_pass http://127.0.0.1:@PORTFOLIO_PORT@;
        include /etc/nginx/ohara-proxy-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    # Images and the favicon are not versioned: a week, then revalidate by ETag.
    location ^~ /static/img/ {
        proxy_pass http://127.0.0.1:@PORTFOLIO_PORT@;
        include /etc/nginx/ohara-proxy-headers.conf;
        add_header Cache-Control "public, max-age=604800";
    }
    location = /favicon.ico {
        proxy_pass http://127.0.0.1:@PORTFOLIO_PORT@;
        include /etc/nginx/ohara-proxy-headers.conf;
        add_header Cache-Control "public, max-age=604800";
    }
    # Anything else under /static: one hour.
    location ^~ /static/ {
        proxy_pass http://127.0.0.1:@PORTFOLIO_PORT@;
        include /etc/nginx/ohara-proxy-headers.conf;
        add_header Cache-Control "public, max-age=3600";
    }
    location / {
        proxy_pass http://127.0.0.1:@PORTFOLIO_PORT@;
        include /etc/nginx/ohara-proxy-headers.conf;
    }
}
