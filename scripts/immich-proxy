#!/usr/bin/env python3
"""Activate Immich on the existing xdadwal.in wildcard Nginx host."""

import argparse
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts/lib'))
import cli
import immich_proxy


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        '--apply', action='store_true', help='root only: back up, test and reload Nginx'
    )
    access = parser.add_mutually_exclusive_group()
    access.add_argument(
        '--onboarding-only',
        action='store_true',
        help='restrict HTTP/HTTPS to loopback and the verified 192.168.1.0/24 LAN before owner signup',
    )
    access.add_argument(
        '--accounts-ready',
        action='store_true',
        help='attest that private owner login has been verified',
    )
    args = parser.parse_args()
    if not args.apply:
        sys.stdout.write(immich_proxy.render(ROOT, onboarding_only=args.onboarding_only))
        return
    immich_proxy.apply(
        ROOT, onboarding_only=args.onboarding_only, accounts_ready=args.accounts_ready
    )


if __name__ == '__main__':
    cli.run(main, 'Immich proxy')
