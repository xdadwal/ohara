#!/usr/bin/env python3
"""Apply the reviewed xdadwal.in LAN-only Nginx baseline on its existing host."""

import argparse
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts/lib'))
import cli
import lan_proxy


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        '--apply', action='store_true', help='root only: back up, validate and reload Nginx'
    )
    args = parser.parse_args()
    if not args.apply:
        print('Reviewed candidate: ' + str(lan_proxy.candidate(ROOT)))
        print('Host-specific: xdadwal.in, LAN 192.168.1.0/24, existing ohara-wildcard certificate.')
        print('Apply with sudo scripts/lan-proxy --apply; preserves unrelated Nginx sites.')
        return
    lan_proxy.apply(ROOT)


if __name__ == '__main__':
    cli.run(main, 'Ohara LAN proxy')
