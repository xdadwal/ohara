#!/usr/bin/env python3
"""Manage mount-dependent media startup; see docs/storage-pool.md."""
import argparse
from pathlib import Path
import subprocess
import sys
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT/'scripts/lib'))
import config
import media_pool


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['install-unit', 'start', 'stop', 'check'])
    args = parser.parse_args()
    c = config.load(ROOT/'.env')
    if not c.get('MEDIA_POOL_MOUNT'):
        raise ValueError('MEDIA_POOL_MOUNT is not configured')
    if args.command == 'install-unit':
        media_pool.install(c, ROOT)
    elif args.command == 'check':
        media_pool.require_mount(c)
        print('Configured mergerfs mount is active')
    else:
        getattr(media_pool, args.command)(c, ROOT)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print('Ohara media pool: '+str(error), file=sys.stderr)
        sys.exit(1)
