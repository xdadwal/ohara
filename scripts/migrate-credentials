#!/usr/bin/env python3
"""Consolidate legacy credential files into private .env without changing values."""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent/'lib'))
from credential_migration import migrate

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--backup-dir', type=Path, help='new private directory outside the checkout')
    args = parser.parse_args()
    try:
        backup = migrate(Path(__file__).resolve().parents[1], args.backup_dir)
        print('Credentials consolidated; private backup: '+str(backup) if backup else
              'Unified .env already configured; no changes made.')
        print('Recreate Homepage with scripts/up to apply its environment; account passwords were not rotated.')
    except (OSError, ValueError) as error:
        print(f'Ohara: {error}', file=sys.stderr)
        sys.exit(1)
