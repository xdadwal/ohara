#!/usr/bin/env python3
"""Consolidate legacy credential files into private .env without changing values."""

import argparse
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts/lib'))
import cli
from credential_migration import migrate


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        '--backup-dir', type=Path, help='new private directory outside the checkout'
    )
    args = parser.parse_args()
    backup = migrate(ROOT, args.backup_dir)
    print(
        'Credentials consolidated; private backup: ' + str(backup)
        if backup
        else 'Unified .env already configured; no changes made.'
    )
    print(
        'Recreate Homepage with scripts/up to apply its environment; account passwords were not rotated.'
    )


if __name__ == '__main__':
    cli.run(main, 'Ohara', errors=(OSError, ValueError))
