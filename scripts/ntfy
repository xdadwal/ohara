#!/usr/bin/env python3
"""Operate the independent ntfy notification server; see docs/ntfy.md."""
import argparse
from pathlib import Path
import sys
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'scripts/lib'))
import config
import ntfy

if __name__=='__main__':
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('command',choices=['check','prepare','up','stop','status','test','homepage','dns','install-alerts','rotate-account','seerr','widget'])
    p.add_argument('--static',action='store_true')
    a=p.parse_args()
    try:
        if a.static and a.command!='check':p.error('--static is only for check')
        c=config.load(ROOT/('.env.example' if a.static else '.env'))
        if a.command=='check':ntfy.check(c,ROOT,static=a.static)
        elif a.command=='up':
            ntfy.check(c,ROOT);ntfy.compose(c,ROOT,['up','-d','--wait','--wait-timeout','90'],timeout=300);ntfy.status(c,ROOT)
        elif a.command=='stop':ntfy.compose(c,ROOT,['stop'])
        elif a.command=='rotate-account':ntfy.rotate_account(c,ROOT)
        elif a.command in ('install-alerts','seerr'):
            import alerts
            getattr(alerts,'install' if a.command=='install-alerts' else 'seerr')(c,ROOT)
        else:getattr(ntfy,a.command)(c,ROOT)
    except Exception as e:
        print('Ohara ntfy: '+str(e),file=sys.stderr);sys.exit(1)
