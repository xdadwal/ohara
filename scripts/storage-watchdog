#!/usr/bin/env python3
"""Run opt-in host storage recovery; installation: docs/storage-pool.md."""

import argparse
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts/lib'))
import cli
import storage_watchdog


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['install', 'run'])
    parser.add_argument('--config', type=Path)
    args = parser.parse_args()
    if args.command == 'install':
        if args.config is None:
            parser.error('install requires --config PATH')
        storage_watchdog.install(ROOT, args.config)
    else:
        storage_watchdog.run()


if __name__ == '__main__':
    cli.run(main, 'Storage watchdog', errors=Exception)
