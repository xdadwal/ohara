#!/usr/bin/env python3
"""Check, then start the main stack on loopback; never changes public routes."""

import argparse
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts/lib'))
import cli
import config
import runtime


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    c = config.load(ROOT / '.env')
    runtime.check(c, ROOT)
    runtime.compose(c, ROOT, ['up', '-d', '--wait', '--wait-timeout', '180'], timeout=900)
    print(
        'Local stack started. Complete account setup through SSH forwarding before public activation.'
    )


if __name__ == '__main__':
    cli.run(main, 'Ohara')
